  "components": {
    "schemas": {
      "AppUser": {
        "required": [
          "email",
          "fullName",
          "passwordHash",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 100,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "type": "string"
          },
          "passwordHash": {
            "maxLength": 255,
            "type": "string"
          },
          "role": {
            "maxLength": 20,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organisedEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "nullable": true
          },
          "enrolments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Enrolment"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Category": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryName": {
            "maxLength": 80,
            "type": "string"
          },
          "description": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          },
          "enrolments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Enrolment"
            },
            "nullable": true
          },
          "eventCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategory"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DateOnly": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "dayOfWeek": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "dayOfYear": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "dayNumber": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "DayOfWeek": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "Enrolment": {
        "required": [
          "categoryId",
          "eventId",
          "participantId",
          "status"
        ],
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "maxLength": 20,
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "participant": {
            "$ref": "#/components/schemas/AppUser"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "required": [
          "city",
          "eventName",
          "eventType",
          "organiserId",
          "province",
          "status",
          "venue"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "organiserId": {
            "type": "integer",
            "format": "int32"
          },
          "eventName": {
            "maxLength": 150,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventType": {
            "maxLength": 20,
            "type": "string"
          },
          "eventDate": {
            "$ref": "#/components/schemas/DateOnly"
          },
          "startTime": {
            "$ref": "#/components/schemas/TimeOnly"
          },
          "venue": {
            "maxLength": 150,
            "type": "string"
          },
          "city": {
            "maxLength": 80,
            "type": "string"
          },
          "province": {
            "maxLength": 80,
            "type": "string"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "maxParticipants": {
            "type": "integer",
            "format": "int32"
          },
          "entryFee": {
            "type": "number",
            "format": "double"
          },
          "routeInformation": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "weatherInformation": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "status": {
            "maxLength": 20,
            "type": "string"
          },
          "organiser": {
            "$ref": "#/components/schemas/AppUser"
          },
          "enrolments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Enrolment"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EventCategory": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "fullName",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Result": {
        "required": [
          "resultStatus"
        ],
        "type": "object",
        "properties": {
          "resultId": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "finishPosition": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "finishTimeSeconds": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "paceSecondsPerKm": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "resultStatus": {
            "maxLength": 20,
            "type": "string"
          },
          "enrolment": {
            "$ref": "#/components/schemas/Enrolment"
          }
        },
        "additionalProperties": false
      },
      "TimeOnly": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "minute": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "second": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "millisecond": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "microsecond": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "nanosecond": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "ticks": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "$ref": "#/components/schemas/DateOnly"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste your JWT token here. Enter the token only, without the word Bearer.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}